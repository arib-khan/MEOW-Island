<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/meow_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/meow_widget_round_bg" android:orientation="vertical" android:gravity="center" android:padding="14dp">
    <TextClock android:id="@+id/meow_date" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:format12Hour="EEE, d MMM" android:format24Hour="EEE, d MMM" android:textSize="12sp" android:textColor="#C9B6FF"/>
    <TextClock android:id="@+id/meow_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:format12Hour="hh&#10;mm" android:format24Hour="HH&#10;mm" android:textSize="46sp" android:textColor="#B79CFF"
        android:fontFamily="sans-serif-medium" android:lineSpacingMultiplier="0.82" android:includeFontPadding="false" android:gravity="center"/>
    <TextView android:id="@+id/meow_extra" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="12sp" android:textColor="#FF9EC7" android:layout_marginTop="2dp"/>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000"/>
            <stroke android:width="4dp" android:color="#337C4DFF"/>
            <corners android:radius="28dp"/>
        </shape>
    </item>
    <item android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#F21B1432" android:endColor="#F20D0A18"/>
            <stroke android:width="1.5dp" android:color="#8A5CFF"/>
            <corners android:radius="26dp"/>
        </shape>
    </item>
</layer-list>
